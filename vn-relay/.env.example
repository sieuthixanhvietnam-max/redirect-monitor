# === VN Relay config ===
# Sinh key: openssl rand -hex 32
RELAY_API_KEY=doi_thanh_key_ngau_nhien_dai_it_nhat_32_ky_tu

RELAY_NODE_NAME=vn-relay-1
PORT=8787
HOST=0.0.0.0

# So request HTTP song song toi da
RELAY_CONCURRENCY=24
# So tab Chromium song song toi da (nang, de thap)
RELAY_BROWSER_CONCURRENCY=2
# Dong Chromium sau bao lau khong dung (ms)
BROWSER_IDLE_MS=120000

LOG_LEVEL=info

# === DIEM QUAN SAT / PROXY (tuy chon) ===
# Khai bao nhieu diem di ra khac nhau trong CUNG mot relay. Ten 'direct' luon
# co san va co nghia la khong qua proxy.
#
# LUU Y: phai boc trong nhay kep, vi ky tu | se bi shell hieu la pipe khi source .env
# RELAY_PROXIES="vn-4g|http://user:pass@host:port,vn-dc|http://host:port"
#
# Dang cu (mot proxy duy nhat) van chay, thanh diem ten 'default':
# RELAY_PROXY=http://user:pass@host:port
#
# Chi ho tro http/https (khong socks). Khai bao sai -> relay bao loi va thoat han,
# KHONG am tham di ra bang IP that.
#
# Vi sao can nhieu diem: cung mot domain co the cho ba ket qua khac nhau —
#   IP nuoc ngoai      -> 403 (Cloudflare chan dai datacenter ngoai)
#   IP datacenter VN   -> 200
#   IP nha mang VN(4G) -> dut o tang TLS (nha mang chan theo SNI)
# Khong cai nao la "dung"; moi cai tra loi mot cau hoi khac nhau.
#
# Kiem tra tung diem:
#   curl -H "x-api-key: <KEY>" "http://127.0.0.1:8787/egress-ip?via=vn-4g"
