# Ban nhe: chi HTTP mode, KHONG co Chromium (~120MB thay vi ~1.5GB).
# Dung khi may VN yeu (RAM < 1GB) va ban chap nhan khong vuot duoc bot-protection.
FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache tini

COPY package.json ./
RUN npm install --omit=dev --omit=optional

COPY server.js ./
COPY lib ./lib

EXPOSE 8787
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]
