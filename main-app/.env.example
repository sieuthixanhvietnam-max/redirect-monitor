# ============ RELAY VIET NAM (quan trong nhat) ============
# Cach 1 - mot relay:
RELAY_URL=https://relay.tenmiencuaban.com
RELAY_API_KEY=phai_trung_voi_RELAY_API_KEY_ben_vn-relay
RELAY_NAME=vn-relay-1

# Cach 2 - nhieu relay (de failover). Dinh dang: ten|url|apikey, cach nhau bang dau phay
# Neu dat RELAY_NODES thi RELAY_URL/RELAY_API_KEY o tren bi bo qua.
# RELAY_NODES=vn-hn|https://relay1.abc.com|key1,vn-hcm|https://relay2.abc.com|key2

# Khi TAT CA relay chet: true = quet thang tu server nay (IP khong phai VN, ket qua co the sai)
#                        false = bo qua lan quet do, ghi loi
ALLOW_DIRECT_FALLBACK=true

# ============ NHIP QUET ============
DEFAULT_INTERVAL_SEC=15
MIN_INTERVAL_SEC=10
# Xe dich ngau nhien +/- % de khong dap cung luc
JITTER_PCT=15
MAX_CONCURRENCY=24
REQUEST_TIMEOUT_SEC=20

# So lan xac nhan lien tiep truoc khi ghi nhan la thay doi that (chong bao dong gia).
# 2 = an toan. 1 = bao ngay nhung de bi nhieu.
CONFIRM_THRESHOLD=2
ERROR_THRESHOLD=3

# ============ DASHBOARD ============
DASHBOARD_USER=admin
# De trong = KHONG co mat khau (chi dung khi test local!)
DASHBOARD_PASSWORD=doi_mat_khau_nay

# ============ KHAC ============
DB_PATH=/app/data/monitor.db
RETENTION_DAYS=365

# ============ GIAM SAT DA DIEM ============
# Ten phai trung voi RELAY_PROXIES ben vn-relay (cong them 'direct').
# De trong = tat, he thong chay y het truoc day.
VANTAGES=vn-4g,vn-dc,direct
# Diem quyet dinh trang thai + canh bao. CAC DIEM KHAC CHI DE DOI CHIEU,
# khong bao gio duoc dung de ket luan trang thai hay ban canh bao.
PRIMARY_VANTAGE=vn-4g
# Nhip doi chieu cac diem phu (giay). Cham hon nhip chinh nhieu la co y:
# muc dich la phat hien cloaking / chan theo vung, khong phai canh bao tuc thi.
VANTAGE_COMPARE_SEC=300
